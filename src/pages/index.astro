---
import HomeIsland from '../components/home/HomeIsland';
import BaseLayout from '../layouts/BaseLayout.astro';
import { defaultLocale, t } from '../i18n';

const locale = Astro.currentLocale ?? defaultLocale;
---

<BaseLayout
  locale={locale}
  title={t(locale, 'Island Home')}
  description={t(locale, '这里会慢慢收集我的前端项目、摄影作品和生活片段。')}
  showInitialLoading
>
  <HomeIsland locale={locale} client:only="react">
    <main class="home-fallback" slot="fallback" aria-labelledby="fallback-title">
      <p>{t(locale, '个人小岛控制台')}</p>
      <h1 id="fallback-title">{t(locale, 'Island Home')}</h1>
      <p>{t(locale, '这里会慢慢收集我的前端项目、摄影作品和生活片段。')}</p>
    </main>
  </HomeIsland>
</BaseLayout>

<style>
  .home-fallback {
    width: min(100%, 760px);
    min-height: 100dvh;
    display: grid;
    align-content: center;
    gap: 16px;
    margin: 0 auto;
    padding: 32px 18px;
    color: #725d42;
  }

  .home-fallback p,
  .home-fallback h1 {
    margin: 0;
  }

  .home-fallback h1 {
    font-size: clamp(42px, 9vw, 84px);
    line-height: 1;
    letter-spacing: 0;
  }
</style>
