---
import PortableText from '../../../components/content/PortableText';
import TagList from '../../../components/island/TagList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, t } from '../../../i18n';
import {
  getNoteBySlug,
  getNotes,
} from '../../../lib/content/notes';

import '../../../styles/island-pages.css';

export async function getStaticPaths() {
  const notes = await getNotes();

  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { slug: note.slug },
  }));
}

const { slug } = Astro.props;
const note = await getNoteBySlug(slug);
const locale = Astro.currentLocale ?? defaultLocale;
const dateFormatter = new Intl.DateTimeFormat(locale, { dateStyle: 'medium' });
---

<BaseLayout
  locale={locale}
  title={`${note.title} | ${t(locale, 'Island Home')}`}
  description={note.description}
  ogType="article"
>
  <main class="island-content-page island-note">
    <article>
      <nav class="island-note__nav" aria-label={t(locale, '文章导航')}>
        <a class="island-note__back-link" href="/island/notes/">
          <span aria-hidden="true">←</span>
          {t(locale, '返回文章列表')}
        </a>
      </nav>
      <header class="island-content-page__hero">
        <h1>{note.title}</h1>
        <p>{note.description}</p>
        <div class="island-note__meta-row">
          <div class="island-card__meta">
            <span class="island-pill">{dateFormatter.format(new Date(note.publishedAt))}</span>
          </div>
          <TagList items={note.tags} />
        </div>
      </header>
      <div class="island-card island-note__body">
        <PortableText value={note.body} />
      </div>
    </article>
  </main>
</BaseLayout>
