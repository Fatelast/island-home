---
import IslandPlaceholderPage from '../../../components/island/IslandPlaceholderPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, t } from '../../../i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const title = '开发工坊';
const description = '前端项目会先以占位卡片呈现，后续补充截图、仓库和预览链接。';
---

<BaseLayout locale={locale} title={`${t(locale, title)} | ${t(locale, 'Island Home')}`} description={t(locale, description)}>
  <IslandPlaceholderPage locale={locale} title={title} description={description} />
</BaseLayout>
