---
import { photos } from '../../../data/photos';
import PageShell from '../../../components/island/PageShell.astro';
import PhotoCard from '../../../components/island/PhotoCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, t } from '../../../i18n';

import '../../../styles/island-pages.css';

const locale = Astro.currentLocale ?? defaultLocale;
const title = '海风相册';
const description = '摄影作品先以轻量缩略图和拍摄信息展示，后续再接入大图预览。';
---

<BaseLayout locale={locale} title={`${t(locale, title)} | ${t(locale, 'Island Home')}`} description={t(locale, description)}>
  <PageShell locale={locale} title={title} description={description} kicker="摄影索引" headingId="photos-title">
    <section class="island-content-page__grid island-content-page__grid--photos" aria-label={t(locale, '照片列表')}>
      {
        photos.map((photo) => (
          <PhotoCard locale={locale} photo={photo} />
        ))
      }
    </section>
  </PageShell>
</BaseLayout>
