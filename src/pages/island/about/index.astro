---
import { profileFacts, profileLinks } from '../../../data/profile';
import PageShell from '../../../components/island/PageShell.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultLocale, t } from '../../../i18n';

import '../../../styles/island-pages.css';

const locale = Astro.currentLocale ?? defaultLocale;
const title = '岛民卡';
const description = '这里会整理个人介绍、技能栈、摄影设备和联系方式。';
---

<BaseLayout locale={locale} title={`${t(locale, title)} | ${t(locale, 'Island Home')}`} description={t(locale, description)}>
  <PageShell locale={locale} title={title} description={description} kicker="个人档案" headingId="about-title">
    <section class="island-content-page__grid island-content-page__grid--two" aria-label={t(locale, '个人信息')}>
      <article class="island-card">
        <h2>{t(locale, '基础信息')}</h2>
        <div class="island-fact-list">
          {
            profileFacts.map((fact) => (
              <div class="island-fact">
                <span>{t(locale, fact.label)}</span>
                <strong>{t(locale, fact.value)}</strong>
              </div>
            ))
          }
        </div>
      </article>

      <article class="island-card">
        <h2>{t(locale, '联系入口')}</h2>
        <p>{t(locale, '第一阶段先保留公开链接，后续再补充更完整的联系方式。')}</p>
        <div class="island-card__actions">
          {
            profileLinks.map((link) => (
              <a class="island-action" href={link.href} target="_blank" rel="noreferrer">
                {t(locale, link.label)}
              </a>
            ))
          }
        </div>
      </article>
    </section>
  </PageShell>
</BaseLayout>
