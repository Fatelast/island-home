---
import { islandNavigationItems } from '../../data/islandNavigation';
import { t } from '../../i18n';

interface Props {
  locale: string;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const normalizedCurrentPath = normalizePath(currentPath);
---

<header class="site-header">
  <a class="site-header__brand" href="/" aria-label={t(locale, '小岛地图')}>
    <span class="site-header__mark" aria-hidden="true"></span>
    <span>{t(locale, 'Island Home')}</span>
  </a>
  <nav class="site-header__nav" aria-label={t(locale, '小岛导航')}>
    {
      islandNavigationItems.map((item) => {
        const isActive = normalizePath(item.href) === normalizedCurrentPath;

        return (
          <a
            class:list={['site-header__link', isActive && 'site-header__link--active']}
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
          >
            {t(locale, item.label)}
          </a>
        );
      })
    }
  </nav>
</header>

<style>
  .site-header {
    width: min(100% - 32px, 1180px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    position: sticky;
    top: 16px;
    z-index: 30;
    margin: 18px auto 0;
    padding: 12px;
    border: 2px solid rgba(114, 93, 66, 0.16);
    border-radius: 999px;
    background: rgba(255, 252, 236, 0.82);
    box-shadow: 0 8px 0 rgba(114, 93, 66, 0.1);
    backdrop-filter: blur(10px);
  }

  .site-header__brand,
  .site-header__link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__brand {
    flex: 0 0 auto;
    gap: 10px;
    padding: 0 14px;
    color: #725d42;
    font-size: 18px;
    font-weight: 900;
    transition: transform 180ms ease;
  }

  .site-header__brand:hover {
    transform: translateY(-1px) rotate(-0.3deg);
  }

  .site-header__mark {
    width: 28px;
    height: 28px;
    border-radius: 12px 14px 10px 16px;
    background:
      radial-gradient(circle at 35% 35%, #f7cd67 0 28%, transparent 30%),
      linear-gradient(135deg, #82d5bb, #8ac68a);
    box-shadow: inset 0 0 0 2px rgba(114, 93, 66, 0.16);
    transform: rotate(-8deg);
  }

  .site-header__nav {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 2px 4px;
    scroll-padding-inline: 8px;
    scrollbar-width: none;
  }

  .site-header__nav::-webkit-scrollbar {
    display: none;
  }

  .site-header__link {
    min-width: 96px;
    flex: 0 0 auto;
    position: relative;
    isolation: isolate;
    padding: 0 16px;
    border-radius: 999px;
    color: #725d42;
    font-size: 14px;
    font-weight: 900;
    overflow: visible;
    transition:
      color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
    touch-action: manipulation;
  }

  .site-header__link::after {
    width: 6px;
    height: 6px;
    content: '';
    position: absolute;
    left: 50%;
    bottom: 4px;
    z-index: -1;
    border-radius: 999px;
    background: #19c8b9;
    opacity: 0;
    transform: translateX(-50%) scale(0.4);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .site-header__link:hover {
    background: rgba(130, 213, 187, 0.28);
    transform: translateY(-1px);
  }

  .site-header__link:active {
    transform: translateY(2px);
  }

  .site-header__link--active {
    background: #f7cd67;
    box-shadow: 0 4px 0 rgba(114, 93, 66, 0.16);
  }

  .site-header__link--active::after {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  @media (max-width: 760px) {
    .site-header {
      width: calc(100% - 24px);
      align-items: stretch;
      flex-direction: column;
      border-radius: 24px;
    }

    .site-header__brand {
      justify-content: flex-start;
    }

    .site-header__nav {
      justify-content: flex-start;
      padding-bottom: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__brand,
    .site-header__link,
    .site-header__link::after {
      animation: none;
      transition: none;
    }
  }
</style>
