---
import { t } from '../../i18n';
import TagList from './TagList.astro';

import type { NoteSummary } from '../../lib/content/types';

interface Props {
  locale: string;
  note: NoteSummary;
  formattedDate: string;
}

const { locale, note, formattedDate } = Astro.props;
---

<a class="island-card island-card--link island-card--note" href={`/island/notes/${note.slug}/`}>
  <article>
    <div class="island-card__meta">
      <span class="island-pill">{formattedDate}</span>
      <span class="island-pill">{t(locale, '中文文章')}</span>
    </div>
    <h2>{note.title}</h2>
    <p>{note.description}</p>
    <TagList items={note.tags} />
  </article>
</a>
