    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "animal-island-ui": "^0.9.6",
    "astro": "^6.4.4",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "mdast-util-from-markdown": "^2.0.3",
    "react": "^19.2.7",
