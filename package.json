{
  "name": "island-home",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:i18n": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/i18n.test.ts",
    "test:photos": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/photos.test.ts",
    "test:content": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/content.test.ts",
    "test:migration": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/migration.test.ts",
    "test": "npm run test:i18n && npm run test:photos && npm run test:content && npm run test:migration",
    "migrate:sanity": "node --env-file=.env --disable-warning=ExperimentalWarning --experimental-strip-types scripts/migrate-to-sanity.ts",
    "test:motion": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/page-motion.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@gsap/react": "^2.1.2",
